function jump_to_lost(actor, npc)
	local p1 = patrol("red_forest_teleport_to_lesnik_way")
	local dir = p1:point(0)
	alife():change_actor_level(p1:point(0), p1:level_vertex_id(0), p1:game_vertex_id(0), dir)
end

function agr_transfer_of_all_arts(actor, npc)
	local function transfer_object_item(item)
		if item:clsid() == clsid.artefact_s or item:clsid() == clsid.obj_medkit_s then
			db.actor:transfer_item(item, inv_box_1)
		end
	end
	inv_box_1 = get_story_object("agr_box_for_artifacts")
	actor:inventory_for_each(transfer_object_item)
end

function destroy_object_new(actor, obj, p)
	if p and p[1] then
		obj = get_story_object_id(p[1])
	end
	if obj ~= nil then
		alife():release(alife():object(obj), true)
	end
end