function destroy_object_by_story_id(actor, obj, p)
	local obj
	local story_id = p[1]
	local obj = get_story_object_id(story_id)
	if obj == nil then
		abort("There is no story object with id [%s]", story_id)
	end
	printf("releasing object ["..obj:name().."]")
	alife():release(obj, true)
end

