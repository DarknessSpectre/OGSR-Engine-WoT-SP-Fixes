function satrap_kick_after()
	level.add_cam_effector("camera_effects\\surge_01.anm", 4468, false, "xr_effects.enable_ui")
	local tHours = 9
	local tMin = math.random(0,60)
	if tMin == 60 then
		tHours = 10
		tMin = 0
	end
    level.change_game_time(0,tHours,tMin)
	level_weathers.get_weather_manager():forced_weather_change()
	surge_manager.get_surge_manager().time_forwarded = true
	if(surge_manager.is_started() and level_weathers.get_weather_manager().weather_fx) then
		level.stop_weather_fx()
		level_weathers.get_weather_manager():forced_weather_change()
	end
	db.actor.power = 1
	--_s_sleep.oSleepMgr:Reduce(tHours)
	level.add_pp_effector("fade_in_out.ppe",7, false)
	level.set_pp_effector_factor(7,5.0)
	local sObj2 = sound_object([[actor\die4]])
	sObj2:play_at_pos(db.actor, vector():set(0,0,0), 0, sound_object.s2d)
	level.add_pp_effector("snd_shock.ppe",11, false)
	level.set_pp_effector_factor(11,2.0)
end

function satrap_kick_actor_sound(actor, npc, p)
		local sObj1 = sound_object([[affects\hit_fist]])
	sObj1:play_at_pos(db.actor, vector():set(0,0,0), 0, sound_object.s2d)
	xr_effects.disable_ui(db.actor, nil)
		level.add_pp_effector("snd_shock.ppe",11, false)
	level.set_pp_effector_factor(11,2.0)
end

function satrap_kick_actor_only_effector(actor, npc, p)
		level.add_pp_effector("snd_shock.ppe",11, false)
	level.set_pp_effector_factor(11,2.0)
end

