function yan_b3_place_scaner(actor, npc)
	for i = 1, 5 do
		if xr_conditions.actor_in_zone(actor, npc, {"yan_b3_scaner_"..i})
			and not has_alife_info("yan_b3_scaner_"..i.."_placed") then
			db.actor:give_info_portion("yan_b3_scaner_"..i.."_placed")
			db.actor:give_info_portion("yan_b3_scaner_tutorial_done")
			remove_item(actor, npc, {"jup_b32_scanner_device"})
			spawn_object(actor, nil, {"jup_b32_ph_scanner","yan_b3_scaner_spawn_point_"..i})
		end
	end
end

function yan_b5_place_scaner(actor, npc)
	for i = 1, 3 do
		if xr_conditions.actor_in_zone(actor, npc, {"yan_b5_spawn_radar_"..i})
			and not has_alife_info("yan_b5_scaner_"..i.."_placed") then
			db.actor:give_info_portion("yan_b5_scaner_"..i.."_placed")
			db.actor:give_info_portion("yan_b5_scaner_tutorial_done")
			remove_item(actor, npc, {"jup_b209_monster_scanner"})
			spawn_object(actor, nil, {"jup_b209_ph_scanner","yan_b5_spawn_radar_spawn_point_"..i})
		end
	end
end

function x16_place_bomb(actor, npc)
	for i = 1, 4 do
		if xr_conditions.actor_in_zone(actor, npc, {"x16_bomb_place_"..i})
			and not has_alife_info("x16_bomb_"..i.."_placed") then
			db.actor:give_info_portion("x16_bomb_"..i.."_placed")
			db.actor:give_info_portion("x16_place_bomb_tutorial_done")
			remove_item(actor, npc, {"pri_a25_explosive_charge_item"})
			spawn_object(actor, nil, {"yan_a13_c4_bomb","x16_bomb_place_1_spawn_point_"..i})
		end
	end
end

function x16_place_bomb(actor, npc)
	for i = 1, 4 do
		if xr_conditions.actor_in_zone(actor, npc, {"x16_bomb_place_"..i})
			and not has_alife_info("x16_bomb_"..i.."_placed") then
			db.actor:give_info_portion("x16_bomb_"..i.."_placed")
			db.actor:give_info_portion("x16_place_bomb_tutorial_done")
			remove_item(actor, npc, {"pri_a25_explosive_charge_item"})
			spawn_object(actor, nil, {"yan_a13_c4_bomb","x16_bomb_place_1_spawn_point_"..i})
		end
	end
end

