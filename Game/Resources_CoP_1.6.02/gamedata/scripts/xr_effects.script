local red_forest_teleport_no_paths_reported = false

function red_forest_teleport_actor(actor, npc)
    local points = {}
    for i = 1, 53 do
        local name = "red_forest_teleport_" .. i .. "_spawn_point"
        if level.patrol_path_exists(name) then
            local path = patrol(name)
            if path:count() > 0 then
                points[#points + 1] = path:point(0)
            end
        end
    end

    if #points == 0 then
        if not red_forest_teleport_no_paths_reported then
            printf("[red_forest_teleport_actor] No valid destinations; teleport skipped")
            red_forest_teleport_no_paths_reported = true
        end
        return
    end

    local point_out = points[math.random(1, #points)]
    local out_position = vector():set(point_out.x, point_out.y, point_out.z)
    db.actor:set_actor_position(out_position)
    level.add_pp_effector("snd_shock.ppe", 7, false)
    level.set_pp_effector_factor(7, 5.0)
    db.actor.psy_health = -0.1
end

